rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Rides collection
    match /rides/{rideId} {
      // Passengers can create their own ride requests
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      
      // Anyone involved (passenger, driver, or admin) can read the ride
      allow read: if isAuthenticated();

      // Updates:
      // 1. Passenger can update their offer, cancel, or rate
      // 2. Driver can submit offers or update trip status when accepted
      // 3. Admin has full override
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.passengerId ||
        request.auth.uid == resource.data.driverId ||
        isAdmin() ||
        // Allow nearby authenticated drivers to append offers to the ride
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offers', 'updatedAt', 'status'])
      );

      allow delete: if isAdmin();
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      // Driver can register their own profile
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Driver can update their own status/online/location, but status approval is admin only
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Users (passengers) collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Chat messages
    match /chats/{chatId} {
      allow read, create: if isAuthenticated();
    }

    // Fare Configuration (Admin editable, public read)
    match /fares/{fareId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
